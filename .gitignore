node_modules/
dist/
.DS_Store
*.log
.osgrep
nanobanana-output/
.mystra/
.mystra-cache/

# Local scratch — screenshots, dogfood iter dirs, HARs, ad-hoc captures.
# These accumulate during exploratory runs and shouldn't enter history.
.tmp/

# Vitest reuses this between runs to skip-cache passing tests; bumps on
# every invocation, never useful in git.
node_modules/.vite/

# Python cache
__pycache__/
*.pyc

# TypeScript build cache
tsconfig.tsbuildinfo

# Rust build output
target/

# Per-clone Claude Code permissions and session-local agent state.
.claude/settings.local.json

# Per-clone Portolan runtime state — playgrounds, screenshots, kanban iterations.
.portolan/

# Local research artifacts — generated tapestries, downloaded papers, evidence files.
# These belong in the user's working directory, not in git.
results/

# Personal scratch transcripts (voice ingress, meeting captures).
transcription.md

# Felt store symlinks into the user's loom; never commit it.
.felt
