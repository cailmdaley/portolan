{
  "name": "portolan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "native:index": "cargo build --manifest-path crates/portolan-index/Cargo.toml --release && mkdir -p server/dist/native && cp crates/portolan-index/target/release/portolan-index server/dist/native/portolan-index",
    "native:agent": "cargo build --manifest-path crates/portolan-agent/Cargo.toml --release",
    "native:agent:linux": "cargo zigbuild --manifest-path crates/portolan-agent/Cargo.toml --release --target x86_64-unknown-linux-gnu.2.28",
    "native:agent:copy": "npm run native:agent && mkdir -p ~/.local/bin && cp crates/portolan-agent/target/release/portolan-agent-rust ~/.local/bin/portolan-agent-rust",
    "native:agent:default-smoke": "bash scripts/remote-agent-default-rust-smoke.sh",
    "native:assets": "npm run build && npm --prefix server run build && npm run native:index",
    "native:backend-smoke": "bash scripts/native-backend-smoke.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.1",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.1",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.39.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@replit/codemirror-vim": "6.3.0",
    "@tauri-apps/api": "2.11.0",
    "@types/d3-transition": "3.0.9",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "date-fns": "4.1.0",
    "fzy.js": "0.4.1",
    "katex": "0.16.27",
    "marked": "17.0.1",
    "marked-katex-extension": "5.1.6",
    "pdfjs-dist": "5.6.205",
    "react": "18.3.1",
    "react-arborist": "3.5.0",
    "react-dom": "18.3.1",
    "three": "0.172.0",
    "tinykeys": "3.0.0",
    "vellum-reader": "file:../vellum"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.0",
    "@types/d3-drag": "3.0.7",
    "@types/d3-ease": "3.0.2",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/sharp": "0.31.1",
    "@types/three": "0.172.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.5",
    "jsdom": "29.1.1",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "4.1.5"
  },
  "overrides": {
    "rollup": "4.59.0",
    "picomatch": "4.0.4",
    "postcss": "8.5.10"
  }
}
