# This project uses bun (see bunfig.toml). Bun honors minimumReleaseAge from
# bunfig.toml — npm does not. Anyone reaching for npm here should at least
# keep version pins exact.
#
# (The previous `min-release-age=7` line was a no-op under npm and would
# resolve to 7 minutes if read by pnpm — neither was what we wanted.)
save-exact=true
